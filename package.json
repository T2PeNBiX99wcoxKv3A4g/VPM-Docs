{
  "name": "vpm-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "node scripts/prepare.mjs && vitepress dev docs",
    "docs:build": "node scripts/prepare.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "upgrade": "node -e \"require('fs').rmSync('package-lock.json',{force:true})\" && npx npm-check-updates -u && npm install"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
